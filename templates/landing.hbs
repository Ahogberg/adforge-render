<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{bundle.landingPage.headline}} — {{company}}</title>
<style>
{{{design.type.css}}}
{{{design.cssVariables}}}
*{box-sizing:border-box}
body{margin:0;font-family:var(--font-text);background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased}
h1,h2,.guide h3{font-family:var(--font-display);font-weight:var(--display-weight);letter-spacing:var(--display-tracking);text-wrap:balance;margin:0}
.nav{max-width:1180px;margin:auto;height:76px;padding:0 28px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--rule)}
.brand{font-weight:650;letter-spacing:.02em}
.nav span{color:var(--muted);font-size:14px}
.hero{max-width:1180px;margin:auto;padding:84px 28px 96px;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.8fr);gap:72px;align-items:center}
.eyebrow{color:var(--accent-text);font-size:12px;font-weight:650;letter-spacing:.16em;text-transform:uppercase}
h1{font-size:clamp(42px,5.4vw,72px);line-height:1.03;margin:20px 0 22px}
.sub{font-size:19px;line-height:1.6;color:var(--muted);max-width:600px;margin:0}
.bullets{list-style:none;padding:0;margin:34px 0 0;display:grid;gap:14px;max-width:560px}
.bullets li{display:grid;grid-template-columns:22px 1fr;gap:12px;font-size:17px;line-height:1.5}
.bullets li::before{content:'';width:14px;height:14px;margin-top:5px;border-radius:3px;background:var(--accent)}
.side{display:grid;gap:18px}
.guide{position:relative;padding:34px 32px 26px;background:var(--dark);color:var(--on-dark);border-radius:8px;box-shadow:0 30px 70px rgba(20,20,20,.18);overflow:hidden}
.guide small{color:var(--accent-on-dark);font-size:11px;font-weight:650;letter-spacing:.16em;text-transform:uppercase}
.guide h3{font-size:30px;line-height:1.08;margin:16px 0 10px;color:var(--on-dark)}
.guide p{margin:0;color:var(--muted-on-dark);font-size:14px;line-height:1.55}
.guide .wave{margin-top:26px;height:54px}.guide .wave svg{width:100%;height:100%;display:block}
.form{padding:30px 32px 32px;background:#fff;border:1px solid var(--rule);border-radius:8px}
.form h2{font-size:26px;line-height:1.15}
.form p{margin:8px 0 18px;color:var(--muted);font-size:15px;line-height:1.55}
.input{display:block;width:100%;padding:14px 15px;margin-top:10px;border:1px solid var(--rule);border-radius:6px;background:var(--paper);font:inherit;font-size:15px}
.button{width:100%;margin-top:14px;padding:16px;border:0;border-radius:6px;background:var(--accent);color:var(--on-accent);font:inherit;font-size:16px;font-weight:650;cursor:pointer}
.contents{max-width:1180px;margin:auto;padding:0 28px 96px}
.contents h2{font-size:15px;font-family:var(--font-text);font-weight:650;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);padding-bottom:14px;border-bottom:1px solid var(--ink)}
.contents ol{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.contents li{padding:22px 24px 22px 0;border-bottom:1px solid var(--rule);font-family:var(--font-display);font-size:21px;line-height:1.25;letter-spacing:var(--display-tracking)}
.contents li span{display:block;margin-bottom:8px;font-family:var(--font-text);font-size:12px;color:var(--accent-text);letter-spacing:.1em}
@media(max-width:860px){.hero{grid-template-columns:1fr;gap:44px;padding-top:56px}}
</style>
</head>
<body>
<nav class="nav"><div class="brand">{{company}}</div><span>Free field guide</span></nav>
<main>
  <section class="hero">
    <div>
      <div class="eyebrow">{{bundle.landingPage.eyebrow}}</div>
      <h1>{{bundle.landingPage.headline}}</h1>
      <p class="sub">{{bundle.landingPage.subheadline}}</p>
      <ul class="bullets">{{#each bundle.landingPage.bullets}}<li>{{this}}</li>{{/each}}</ul>
    </div>
    <div class="side">
      <div class="guide"><small>Field guide</small><h3>{{bundle.title}}</h3><p>{{bundle.subtitle}}</p><div class="wave">{{{wave}}}</div></div>
      <form class="form" onsubmit="return false"><h2>{{bundle.landingPage.formHeading}}</h2><p>Enter your details and we will email you the guide.</p><input class="input" aria-label="First name" placeholder="First name"><input class="input" type="email" aria-label="Work email" placeholder="Work email"><button class="button">{{bundle.landingPage.buttonLabel}}</button></form>
    </div>
  </section>
  <section class="contents"><h2>Inside the guide</h2><ol>{{#each sectionTitles}}<li><span>{{inc @index}}</span>{{this}}</li>{{/each}}</ol></section>
</main>
</body>
</html>
