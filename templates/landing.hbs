<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{bundle.landingPage.headline}} — {{project.intake.companyName}}</title>
<style>:root{--brand:{{brand.primaryColor}};--bg:{{brand.backgroundColor}};--ink:{{brand.textColor}} }*{box-sizing:border-box}body{margin:0;font-family:{{brand.fontFamily}},Arial,sans-serif;background:#f7f7f5;color:#171817}.nav{height:72px;padding:0 5vw;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #ddd}.brand{font-weight:750}.hero{min-height:calc(100vh - 72px);max-width:1160px;margin:auto;padding:80px 30px;display:grid;grid-template-columns:1.1fr .7fr;gap:80px;align-items:center}.eyebrow{color:var(--brand);font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}h1{font-size:clamp(44px,6vw,78px);line-height:1.02;letter-spacing:-.055em;margin:18px 0 24px}.sub{font-size:18px;line-height:1.7;color:#666;max-width:650px}.bullets{list-style:none;padding:0;margin:32px 0;display:grid;gap:12px}.bullets li:before{content:'✓';color:var(--brand);font-weight:800;margin-right:12px}.form{background:#fff;border:1px solid #ddd;padding:40px;box-shadow:0 24px 80px rgba(0,0,0,.08)}.form h2{font-size:25px;margin:0 0 10px}.form p{color:#777;line-height:1.6}.input{width:100%;padding:14px;margin-top:12px;border:1px solid #ccc;font:inherit}.button{width:100%;border:0;margin-top:12px;padding:15px;background:var(--brand);color:#fff;font-weight:800;font-size:15px}@media(max-width:760px){.hero{grid-template-columns:1fr;padding-top:50px}.nav{padding:0 20px}}</style></head>
<body><nav class="nav"><div class="brand">{{project.intake.companyName}}</div><span>Free practical guide</span></nav><main class="hero"><section><div class="eyebrow">{{bundle.landingPage.eyebrow}}</div><h1>{{bundle.landingPage.headline}}</h1><p class="sub">{{bundle.landingPage.subheadline}}</p><ul class="bullets">{{#each bundle.landingPage.bullets}}<li>{{this}}</li>{{/each}}</ul></section><aside class="form"><h2>{{bundle.landingPage.formHeading}}</h2><p>Enter your details to receive the guide.</p><input class="input" aria-label="First name" placeholder="First name"><input class="input" type="email" aria-label="Work email" placeholder="Work email"><button class="button">{{bundle.landingPage.buttonLabel}}</button></aside></main></body></html>
