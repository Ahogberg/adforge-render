<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Editorial brief — {{company}}</title>
  <style>
    {{{design.type.css}}}
    {{{design.cssVariables}}}
    * { box-sizing: border-box; }
    @page { size: A4; margin: 0; }
    html { -webkit-font-smoothing: antialiased; }
    body { margin: 0; color: var(--ink); background: #fff; font-family: var(--font-text); font-size: 10pt; line-height: 1.55; print-color-adjust: exact; -webkit-print-color-adjust: exact; }
    h1, h2, h3 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-tracking); margin: 0; text-wrap: balance; }
    p { margin: 0; text-wrap: pretty; }
    .page { width: 210mm; height: 297mm; padding: 18mm 18mm 22mm; position: relative; overflow: hidden; page-break-after: always; display: flex; flex-direction: column; }
    .page:last-child { page-break-after: auto; }
    .label { font-size: 7.2pt; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--accent-text); }
    .top { display: flex; justify-content: space-between; padding-bottom: 4mm; border-bottom: .3mm solid var(--rule); }
    .top .label:last-child { color: var(--muted); }
    .folio { position: absolute; left: 18mm; right: 18mm; bottom: 10mm; padding-top: 3mm; border-top: .25mm solid var(--rule); display: flex; justify-content: space-between; color: var(--muted); font-size: 7pt; letter-spacing: .1em; text-transform: uppercase; }
    .intro { margin: 11mm 0 8mm; }
    .intro h1 { font-size: 27pt; line-height: 1.08; max-width: 160mm; margin-top: 3mm; }
    .intro p { margin-top: 4mm; color: var(--muted); max-width: 150mm; }
    .angle { padding: 6mm 7mm; background: var(--tint); border-left: 1mm solid var(--accent); margin-bottom: 8mm; }
    .angle h2 { font-size: 15pt; line-height: 1.25; margin: 2mm 0 3mm; }
    .angle p { color: var(--ink-2, var(--ink)); }
    .ideas { display: grid; gap: 4.5mm; margin: 3mm 0 8mm; }
    .idea { display: grid; grid-template-columns: 10mm 1fr; gap: 3mm; }
    .idea .n { width: 8mm; height: 8mm; border-radius: 50%; background: var(--accent); color: var(--on-accent); display: grid; place-items: center; font-size: 8pt; font-weight: 600; }
    .idea strong { display: block; font-family: var(--font-display); font-weight: var(--display-weight); font-size: 12pt; line-height: 1.3; }
    .idea p { color: var(--muted); font-size: 9.2pt; margin-top: 1mm; }
    .left-out { border-top: .25mm solid var(--rule); padding-top: 5mm; }
    .left-out ul { margin: 3mm 0 0; padding: 0; list-style: none; display: grid; gap: 2.5mm; }
    .left-out li { font-size: 9.2pt; color: var(--muted); }
    .left-out li b { color: var(--ink); font-weight: 600; }
    .plan-intro { margin: 10mm 0 6mm; }
    .plan-intro h1 { font-size: 24pt; margin-top: 3mm; }
    .plan-intro p { margin-top: 3mm; color: var(--muted); max-width: 150mm; }
    table { width: 100%; border-collapse: collapse; font-size: 8.4pt; }
    th { text-align: left; font-size: 6.8pt; letter-spacing: .14em; text-transform: uppercase; color: var(--muted); font-weight: 600; padding: 0 2.5mm 2mm 0; border-bottom: .3mm solid var(--ink); }
    td { padding: 2.1mm 2.5mm 2.1mm 0; border-bottom: .2mm solid var(--rule); vertical-align: top; }
    tr.week-start td { border-top: .5mm solid var(--rule); }
    td.when { white-space: nowrap; color: var(--muted); width: 30mm; }
    td.channel { width: 20mm; }
    .chip { display: inline-block; padding: .6mm 2mm; border-radius: 1mm; font-size: 6.8pt; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; background: var(--tint); color: var(--accent-text); }
    td.what b { font-weight: 600; }
    td.what span { display: block; color: var(--muted); }
  </style>
</head>
<body>
  {{#if brief}}
  <section class="page">
    <div class="top"><span class="label">{{company}}</span><span class="label">Editorial brief · {{issueLabel}}</span></div>
    <div class="intro">
      <span class="label">Why this campaign</span>
      <h1>{{bundle.title}}</h1>
      <p>Before writing anything we read the whole recording. This is what we found, the angle we chose for your audience, and what we left out on purpose.</p>
    </div>
    <div class="angle">
      <span class="label">The angle</span>
      <h2>{{bundle.campaignAngle}}</h2>
      <p>{{brief.angleRationale}}</p>
    </div>
    <span class="label">The strongest ideas in the recording</span>
    <div class="ideas">
      {{#each brief.strongestIdeas}}
      <div class="idea"><span class="n">{{inc @index}}</span><div><strong>{{idea}}</strong><p>{{why}}</p></div></div>
      {{/each}}
    </div>
    {{#if brief.leftOut.length}}
    <div class="left-out">
      <span class="label">Left out, on purpose</span>
      <ul>{{#each brief.leftOut}}<li><b>{{idea}}</b> {{why}}</li>{{/each}}</ul>
    </div>
    {{/if}}
    <div class="folio"><span>{{company}} · Editorial brief</span><span>Afterword</span></div>
  </section>
  {{/if}}
  {{#each planPages}}
  <section class="page">
    <div class="top"><span class="label">{{../company}}</span><span class="label">Publishing plan · from {{../planStartLabel}}</span></div>
    {{#if first}}
    <div class="plan-intro">
      <span class="label">The next 30 days</span>
      <h1>When each piece goes out</h1>
      <p>Two posts a week, the carousel in week two, a clip most Fridays and the three emails a week apart. The calendar file in your delivery adds every item to your calendar in one click.</p>
    </div>
    {{else}}
    <div class="plan-intro"><span class="label">Publishing plan, continued</span></div>
    {{/if}}
    <table>
      <thead><tr><th>When</th><th>Channel</th><th>What</th></tr></thead>
      <tbody>
        {{#each rows}}
        <tr class="{{#if weekStart}}week-start{{/if}}"><td class="when">Week {{week}} · {{weekdayShort}} {{dateLabel}}</td><td class="channel"><span class="chip">{{channel}}</span></td><td class="what"><b>{{title}}</b><span>{{detail}}</span></td></tr>
        {{/each}}
      </tbody>
    </table>
    <div class="folio"><span>{{../company}} · Publishing plan</span><span>Afterword</span></div>
  </section>
  {{/each}}
</body>
</html>
