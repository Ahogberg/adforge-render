PORT=3001
ADFORGE_OPERATOR_KEY=change-me-before-deploying
ADFORGE_ALLOWED_ORIGINS=http://localhost:3000,https://adforgecreative.com,https://www.adforgecreative.com
ADFORGE_PUBLIC_URL=http://localhost:3001
ADFORGE_MARKETING_URL=https://adforgecreative.com
ADFORGE_PROSPECT_CONCURRENCY=2

# Persistent root for data/, uploads/, and artifacts/. Defaults to the working directory.
# ADFORGE_STORAGE_DIR=/app/storage

# Leave blank to run the complete product in deterministic demo mode.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Email. One verified Resend sender is used for client notifications and prospect outreach.
# Without these values every email is a recorded dry run.
RESEND_API_KEY=
ADFORGE_OUTREACH_FROM=AdForge <hello@your-verified-domain.com>
ADFORGE_OUTREACH_REPLY_TO=hello@your-verified-domain.com

# Where operator notifications go: new applications, campaigns ready for a check, client decisions, failures.
ADFORGE_OPERATOR_EMAIL=

# true = clients receive the review link the moment the quality gate passes.
# false = you check the campaign first and press "Send to client" in the dashboard.
ADFORGE_AUTO_DELIVER=false
