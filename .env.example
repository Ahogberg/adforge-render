PORT=3001
ADFORGE_OPERATOR_KEY=change-me-before-deploying
ADFORGE_ALLOWED_ORIGINS=http://localhost:3000,https://afterwordmonthly.com
ADFORGE_PUBLIC_URL=http://localhost:3001
ADFORGE_MARKETING_URL=https://adforge-monthly.ahogberg.chatgpt.site
ADFORGE_PROSPECT_CONCURRENCY=2

# Leave blank to run the complete product in deterministic demo mode.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Optional. Without these values, outreach remains in preview/demo mode.
RESEND_API_KEY=
ADFORGE_OUTREACH_FROM=Afterword <hello@your-verified-domain.com>
ADFORGE_OUTREACH_REPLY_TO=hello@your-verified-domain.com

# Optional application confirmation and operator notification.
ADFORGE_INTAKE_FROM=Afterword <hello@your-verified-domain.com>
ADFORGE_INTAKE_REPLY_TO=hello@your-verified-domain.com
ADFORGE_INTAKE_NOTIFY_TO=
