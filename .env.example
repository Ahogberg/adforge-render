PORT=3001
ADFORGE_OPERATOR_KEY=change-me-before-deploying
ADFORGE_ALLOWED_ORIGINS=http://localhost:3000,https://adforgecreative.com
ADFORGE_PUBLIC_URL=http://localhost:3001

# Leave blank to run the complete product in deterministic demo mode.
OPENAI_API_KEY=
OPENAI_CONTENT_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize

# Local filesystem storage is used by default. Set these for S3/R2 in production.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
